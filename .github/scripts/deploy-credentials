#!/usr/bin/env bash
set -euo pipefail

# Check before platform builds. Report names only, never credential contents.
missing=0
for name in TS_OAUTH_CLIENT_ID TS_OAUTH_SECRET DEPLOY_SSH_PRIVATE_KEY DEPLOY_SSH_KNOWN_HOSTS DEPLOY_TARGETS; do
  if [[ ! "${!name:-}" =~ [^[:space:]] ]]; then
    echo "Missing deployment repository secret: $name" >&2
    missing=1
  fi
done
if (( missing )); then
  echo 'Configure these secrets in GitHub Actions before retrying CI on main.' >&2
  exit 1
fi
