#!/bin/sh
set -eu

binary=${1:?usage: deploy-smoke BINARY REVISION}
revision=${2:?usage: deploy-smoke BINARY REVISION}
scratch=${TMPDIR:-/tmp}/achi-deploy-$revision-$$
trap 'rm -rf -- "$scratch"' EXIT HUP INT TERM
mkdir -p "$scratch/models"

"$binary" \
  --db "$scratch/achi.sqlite3" \
  --models-dir "$scratch/models" \
  status | grep -q '"ready":false'
