<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2015/06/nuspec.xsd">
  <metadata>
    <id>mash</id>
    <version>@VERSION@</version>
    <title>mash</title>
    <authors>kojah</authors>
    <owners>kojah</owners>
    <projectUrl>https://github.com/kojah/mash</projectUrl>
    <packageSourceUrl>https://github.com/kojah/mash/tree/main/packaging/chocolatey</packageSourceUrl>
    <licenseUrl>https://github.com/kojah/mash/blob/main/LICENSE</licenseUrl>
    <requireLicenseAcceptance>false</requireLicenseAcceptance>
    <releaseNotes>https://github.com/kojah/mash/releases/tag/v@VERSION@</releaseNotes>
    <summary>Search your coding agents' past conversations from a CLI and MCP server</summary>
    <description>Mash indexes Claude Code, Codex, Copilot, Cursor, OpenCode and Antigravity chat histories locally and searches them from a JSON CLI and an MCP server. Run mash init after installing.</description>
    <tags>cli mcp claude-code codex search</tags>
  </metadata>
  <files>
    <file src="tools\**" target="tools" />
  </files>
</package>
