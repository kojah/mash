$ErrorActionPreference = 'Stop'
$toolsDir = Split-Path -Parent $MyInvocation.MyCommand.Definition
Install-ChocolateyZipPackage -PackageName 'mash' -UnzipLocation $toolsDir `
  -Url64bit 'https://github.com/kojah/mash/releases/download/v@VERSION@/mash-x86_64-pc-windows-msvc.zip' `
  -Checksum64 '@SHA256:mash-x86_64-pc-windows-msvc.zip@' -ChecksumType64 'sha256'
