{
    "version": "@VERSION@",
    "description": "Search your coding agents' past conversations from a CLI and MCP server",
    "homepage": "https://github.com/kojah/mash",
    "license": "MIT",
    "architecture": {
        "64bit": {
            "url": "https://github.com/kojah/mash/releases/download/v@VERSION@/mash-x86_64-pc-windows-msvc.zip",
            "hash": "@SHA256:mash-x86_64-pc-windows-msvc.zip@"
        }
    },
    "bin": ["mash.exe", "mash-server.exe"],
    "notes": "Set Mash up for the agent histories on this machine: mash init",
    "checkver": "github",
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/kojah/mash/releases/download/v$version/mash-x86_64-pc-windows-msvc.zip"
            }
        },
        "hash": {
            "url": "$baseurl/SHA256SUMS"
        }
    }
}
