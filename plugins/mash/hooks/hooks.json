{
  "description": "Mash session recall: project-scoped recent chats, records and pending distillation. Fails open.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/session_start.py\" 2>/dev/null || true",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
