{
  "description": "Mash automatic memory: recall project records and recent chats at session start and file reads; one bounded capture pass at Stop saves only the current interaction's source-backed outcomes. Historical backfill runs separately during explicit setup or maintenance. Fails open; capture opt-out is MASH_RECORD_CAPTURE=off.",
  "hooks": {
    "Stop": [{"hooks": [{"type": "command", "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/python.sh\" \"${CLAUDE_PLUGIN_ROOT}/hooks/record_capture.py\" 2>/dev/null || true", "timeout": 3}]}],
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/python.sh\" \"${CLAUDE_PLUGIN_ROOT}/hooks/session_start.py\" 2>/dev/null || true",
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/python.sh\" \"${CLAUDE_PLUGIN_ROOT}/hooks/prompt_recall.py\" 2>/dev/null || true",
            "timeout": 3
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/python.sh\" \"${CLAUDE_PLUGIN_ROOT}/hooks/file_context.py\" 2>/dev/null || true",
            "timeout": 3
          }
        ]
      }
    ]
  }
}
