{
  "$defs": {
    "Attachment": {
      "additionalProperties": false,
      "description": "A source attachment reference. Binary retention is a separate explicit operation.",
      "properties": {
        "bytes": {
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "id": {
          "$ref": "#/$defs/ConnectorId"
        },
        "media_type": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "url": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "name",
        "media_type",
        "url"
      ],
      "type": "object"
    },
    "Author": {
      "additionalProperties": false,
      "description": "Authorship is separate from agent dialogue roles.",
      "properties": {
        "id": {
          "$ref": "#/$defs/ConnectorId"
        },
        "kind": {
          "$ref": "#/$defs/AuthorKind"
        },
        "name": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "id",
        "kind"
      ],
      "type": "object"
    },
    "AuthorKind": {
      "enum": [
        "human",
        "bot",
        "unknown"
      ],
      "type": "string"
    },
    "Change": {
      "description": "Explicit mutations. No implicit deletion from an incomplete enumeration.",
      "oneOf": [
        {
          "additionalProperties": false,
          "description": "A complete object replacement; omitted optional fields become unknown.\nWhich fields apply depends on `role`; see [`Object::validate`].",
          "properties": {
            "attachments": {
              "default": [],
              "description": "References only; ingestion must not fetch URLs or execute attachments.\nEntries and documents only.",
              "items": {
                "$ref": "#/$defs/Attachment"
              },
              "maxItems": 32,
              "type": "array"
            },
            "author": {
              "anyOf": [
                {
                  "$ref": "#/$defs/Author"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Entries only."
            },
            "content": {
              "description": "Entries and documents only; required for them.",
              "type": [
                "string",
                "null"
              ]
            },
            "created_at": {
              "description": "Unix milliseconds, or unknown. Never inferred from ingestion time.",
              "format": "int64",
              "type": [
                "integer",
                "null"
              ]
            },
            "id": {
              "$ref": "#/$defs/ConnectorId"
            },
            "kind": {
              "$ref": "#/$defs/ConnectorKind"
            },
            "metadata": {
              "anyOf": [
                {
                  "$ref": "#/$defs/Metadata"
                },
                {
                  "type": "null"
                }
              ]
            },
            "op": {
              "const": "upsert-object",
              "type": "string"
            },
            "parent": {
              "anyOf": [
                {
                  "$ref": "#/$defs/ConnectorId"
                },
                {
                  "type": "null"
                }
              ],
              "description": "The containing object within this source; required for entries.\nDeleting a parent deletes its descendants."
            },
            "reply_to": {
              "anyOf": [
                {
                  "$ref": "#/$defs/ConnectorId"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Entries only: the entry this replies to, within the same source."
            },
            "role": {
              "$ref": "#/$defs/Role"
            },
            "title": {
              "type": [
                "string",
                "null"
              ]
            },
            "updated_at": {
              "format": "int64",
              "type": [
                "integer",
                "null"
              ]
            },
            "url": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "op",
            "id",
            "role",
            "kind"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Deletes the object and every descendant.",
          "properties": {
            "id": {
              "$ref": "#/$defs/ConnectorId"
            },
            "op": {
              "const": "delete-object",
              "type": "string"
            }
          },
          "required": [
            "op",
            "id"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Replaces the source's schema; all its objects are re-checked.",
          "properties": {
            "kinds": {
              "items": {
                "$ref": "#/$defs/KindRule"
              },
              "maxItems": 256,
              "minItems": 1,
              "type": "array"
            },
            "op": {
              "const": "declare-schema",
              "type": "string"
            }
          },
          "required": [
            "op",
            "kinds"
          ],
          "type": "object"
        }
      ]
    },
    "ConnectorId": {
      "maxLength": 256,
      "minLength": 1,
      "not": {
        "pattern": "[^A-Za-z0-9._:/@+\\-]"
      },
      "pattern": "^[A-Za-z0-9_][A-Za-z0-9._:/@+\\-]{0,255}$",
      "type": "string"
    },
    "ConnectorKind": {
      "maxLength": 97,
      "minLength": 3,
      "not": {
        "pattern": "[^a-z0-9:-]"
      },
      "pattern": "^[a-z0-9][a-z0-9-]{0,31}:[a-z0-9][a-z0-9-]{0,63}$",
      "type": "string"
    },
    "ConnectorVersion": {
      "const": 2,
      "type": "integer"
    },
    "KindRule": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "$ref": "#/$defs/ConnectorKind"
        },
        "parents": {
          "default": [],
          "description": "Declared kinds this kind may sit directly under.",
          "items": {
            "$ref": "#/$defs/ConnectorKind"
          },
          "maxItems": 256,
          "type": "array"
        },
        "role": {
          "$ref": "#/$defs/Role"
        },
        "root": {
          "default": false,
          "description": "Whether objects of this kind may have no parent.",
          "type": "boolean"
        }
      },
      "required": [
        "kind",
        "role"
      ],
      "type": "object"
    },
    "Metadata": {
      "additionalProperties": true,
      "description": "Deliberately opaque source-specific properties, never interpreted as instructions.\nCommon searchable fields belong to the typed records instead.",
      "type": "object"
    },
    "Role": {
      "description": "What Mash may do with an object, whatever its source calls it.",
      "oneOf": [
        {
          "const": "container",
          "description": "Groups results and owns context, such as a chat, channel or thread.",
          "type": "string"
        },
        {
          "const": "segment",
          "description": "A structural part of a container, such as a turn or review: it gives\ncontext and ancestry, but results still group under the container.",
          "type": "string"
        },
        {
          "const": "entry",
          "description": "Searchable text with an author, such as a message or comment.",
          "type": "string"
        },
        {
          "const": "document",
          "description": "Standalone searchable text, such as a note; never a parent.",
          "type": "string"
        }
      ]
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Transport-independent batch. Applications must validate decoded instances too.",
  "properties": {
    "batch_id": {
      "$ref": "#/$defs/ConnectorId"
    },
    "changes": {
      "items": {
        "$ref": "#/$defs/Change"
      },
      "maxItems": 512,
      "minItems": 1,
      "type": "array"
    },
    "expected_revision": {
      "description": "Optimistic ordering against the last acknowledged source revision.",
      "format": "uint64",
      "minimum": 0,
      "type": "integer"
    },
    "schema_version": {
      "$ref": "#/$defs/ConnectorVersion"
    },
    "source_id": {
      "$ref": "#/$defs/ConnectorId",
      "description": "Stable account/dataset identity shared across copies on different machines."
    }
  },
  "required": [
    "schema_version",
    "source_id",
    "batch_id",
    "expected_revision",
    "changes"
  ],
  "title": "Batch",
  "type": "object",
  "x-mash-limits": {
    "batch_bytes": 8388608,
    "content_bytes": 1048576,
    "metadata_bytes": 262144
  }
}