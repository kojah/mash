{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "files": {
    "includes": [
      "**",
      "!dist",
      "!node_modules",
      "!.astro",
      "!src/content/docs",
      "!pnpm-lock.yaml",
      "!test-results",
      "!playwright-report"
    ]
  },
  "formatter": { "indentStyle": "space", "lineWidth": 100 },
  "linter": { "enabled": true },
  "overrides": [
    {
      "includes": ["**/*.astro"],
      "linter": {
        "rules": { "correctness": { "noUnusedImports": "off", "noUnusedVariables": "off" } }
      }
    }
  ]
}
