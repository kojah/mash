{
  "name": "mash-docs",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.28.5",
  "scripts": {
    "prepare-content": "node scripts/content.ts",
    "dev": "pnpm prepare-content && astro dev",
    "build": "pnpm prepare-content && astro build",
    "check": "pnpm prepare-content && astro sync && tsc --noEmit",
    "lint": "biome check .",
    "test": "vitest run scripts",
    "test:browser": "playwright test"
  },
  "dependencies": {
    "@astrojs/starlight": "0.42.9",
    "@fontsource/ibm-plex-mono": "5.2.7",
    "@fontsource/ibm-plex-sans": "5.2.8",
    "astro": "7.4.5",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-stringify": "^11.0.0",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.5",
    "@playwright/test": "^1.64.1",
    "@types/mdast": "^4.0.4",
    "@types/node": "^24.0.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "vitest": "^5.1.0"
  }
}
