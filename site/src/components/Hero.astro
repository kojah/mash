---
// The landing hero: the logo at full size on the page's plain ground, then
// Starlight's headline, tagline and actions, with the install command ready to copy.
import { Icon, LinkButton } from "@astrojs/starlight/components";
import logoDark from "../../../assets/mash-logo-dark.svg?url";
import logoLight from "../../../assets/mash-logo-light.svg?url";

const { data } = Astro.locals.starlightRoute.entry;
const { title = data.title, tagline, actions = [] } = data.hero ?? {};
// What a visitor pastes into a coding agent to have it do the setup.
const ask = "Read https://getmash.io/setup.md and set up Mash on this machine.";

const cargo = {
  id: "cargo",
  label: "Cargo",
  prompt: "$",
  command: "cargo +stable install --locked --git https://github.com/mashium/mash mash",
};
const brew = {
  id: "brew",
  label: "Homebrew",
  prompt: "$",
  command: "brew install kojah/tap/mash",
};
const apt = {
  id: "apt",
  label: "apt",
  prompt: "$",
  command:
    'curl -fsSL https://getmash.io/apt/mash-archive-keyring.gpg | sudo tee /usr/share/keyrings/mash-archive-keyring.gpg >/dev/null && echo "deb [signed-by=/usr/share/keyrings/mash-archive-keyring.gpg] https://getmash.io/apt stable main" | sudo tee /etc/apt/sources.list.d/mash.list && sudo apt update && sudo apt install mash',
};
const script = {
  id: "script",
  label: "Script",
  prompt: "$",
  command: "curl -fsSL https://raw.githubusercontent.com/mashium/mash/main/install.sh | sh",
};
const systems = [
  { id: "macos", label: "macOS", icon: "apple", methods: [script, brew, cargo] },
  { id: "linux", label: "Linux", icon: "linux", methods: [script, apt, cargo] },
  {
    id: "windows",
    label: "Windows",
    icon: "seti:windows",
    methods: [
      {
        id: "script",
        label: "PowerShell",
        prompt: ">",
        command: "irm https://raw.githubusercontent.com/mashium/mash/main/install.ps1 | iex",
      },
      {
        id: "scoop",
        label: "Scoop",
        prompt: ">",
        command:
          "scoop bucket add mashium https://github.com/mashium/mash; scoop install mashium/mash",
      },
      cargo,
    ],
  },
];
// Each install method's mark, by its id, or by system and id where one
// system's differs. apt and Scoop have no mark in the
// icon set, so they share the download arrow.
const methodIcons = {
  script: "seti:shell",
  "windows:script": "seti:powershell",
  brew: "homebrew",
  apt: "download",
  scoop: "download",
  cargo: "seti:rust",
} as const;
// Without scripting the page shows the macOS and Linux script.
const first = script;
---

<div class="mash-hero">
  <div class="hero">
    <div class="sl-flex stack">
      <div class="mash-logo">
        <img class="on-dark" src={logoDark} alt="Mash" width="4995" height="1497" />
        <img class="on-light" src={logoLight} alt="Mash" width="4995" height="1497" />
      </div>
      <div class="sl-flex copy">
        <h1 id="_top" data-page-title set:html={title} />
        {
          tagline && (
            <p class="tagline">
              <Fragment set:html={tagline} />{" "}
              <a class="mash-try" href="/demo/" data-astro-reload>Try it →</a>
            </p>
          )
        }
      </div>
      {
        actions.length > 0 && (
          <div class="sl-flex actions">
            {actions.map(({ attrs: { class: className, ...attrs } = {}, icon, link, text, variant }) => (
              <LinkButton href={link} {variant} icon={icon?.name} class:list={[className]} {...attrs}>
                {text}
                {icon?.html && <Fragment set:html={icon.html} />}
              </LinkButton>
            ))}
          </div>
        )
      }
      <div class="mash-install" data-systems={JSON.stringify(systems)}>
        <div class="choice mode" role="group" aria-label="How to set up" data-pick="mode">
          <button type="button" value="agent" aria-pressed="true">
            <Icon name="comment" size="0.9375rem" />
            Ask your agent
          </button>
          <button type="button" value="manual" aria-pressed="false">
            <Icon name="seti:shell" size="0.9375rem" />
            Install it yourself
          </button>
        </div>
        <h2>Paste into your coding agent</h2>
        <div class="command agent">
          <code class="wrap">{ask}</code>
          <button type="button" data-copy={ask} aria-label="Copy the prompt for your agent">Copy</button>
        </div>
        <h2>or install it yourself</h2>
        <div class="choices">
          <div class="choice" role="group" aria-label="Operating system" data-pick="system">
            {
              systems.map((system) => (
                <button type="button" value={system.id} aria-pressed="false">
                  <Icon name={system.icon} size="0.9375rem" />
                  {system.label}
                </button>
              ))
            }
          </div>
          <div class="choice" role="group" aria-label="Install method" data-pick="method"></div>
          {
            Object.entries(methodIcons).map(([id, name]) => (
              <template data-method-icon={id}>
                <Icon name={name} size="0.9375rem" />
              </template>
            ))
          }
        </div>
        <div class="command picked">
          <span class="prompt" aria-hidden="true">{first.prompt}</span>
          <code>{first.command}</code>
          <button type="button" data-copy={first.command} aria-label="Copy the install command">Copy</button>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  // One listener serves every page change. The button says so once it has copied.
  document.addEventListener("click", async (event) => {
    const button = event.target instanceof Element ? event.target.closest("button[data-copy]") : null;
    if (!(button instanceof HTMLButtonElement)) return;
    try {
      await navigator.clipboard.writeText(button.dataset.copy ?? "");
      button.textContent = "Copied";
      setTimeout(() => {
        button.textContent = "Copy";
      }, 2000);
    } catch {
      // Without clipboard access, select the command so it can be copied by hand.
      const code = button.parentElement?.querySelector("code");
      if (code) getSelection()?.selectAllChildren(code);
    }
  });
</script>

<script>
  import { mountInstall } from "../install.ts";

  // Runs on the first load and after each page change.
  document.addEventListener("astro:page-load", () => {
    for (const picker of document.querySelectorAll<HTMLElement>(".mash-install")) mountInstall(picker);
  });
</script>

<style>
  .mash-logo {
    width: min(100%, 55rem);
    align-self: center;
  }
  .mash-logo img {
    display: block;
    width: 100%;
    height: auto;
  }
  .mash-logo .on-light,
  :global([data-theme="light"]) .mash-logo .on-dark {
    display: none;
  }
  :global([data-theme="light"]) .mash-logo .on-light {
    display: block;
  }
  .hero {
    display: grid;
    grid-template-columns: 100%;
    align-items: center;
    padding-bottom: 1rem;
  }
  .stack {
    flex-direction: column;
    gap: clamp(1.5rem, calc(1.5rem + 1vw), 2rem);
    text-align: center;
  }
  .copy {
    flex-direction: column;
    gap: 1rem;
    align-items: center;
  }
  .copy > * {
    max-width: 50ch;
  }
  h1 {
    font-size: clamp(var(--sl-text-3xl), calc(0.25rem + 5vw), var(--sl-text-6xl));
    line-height: var(--sl-line-height-headings);
    font-weight: 600;
    color: var(--sl-color-white);
  }
  .tagline {
    font-size: clamp(var(--sl-text-base), calc(0.0625rem + 2vw), var(--sl-text-xl));
    color: var(--sl-color-gray-2);
  }
  .mash-try {
    color: var(--sl-color-accent);
    font-weight: 600;
    text-decoration: none;
    white-space: nowrap;
  }
  .mash-try:hover {
    color: var(--sl-color-accent-high);
    text-decoration: underline;
  }

  .mash-install {
    display: grid;
    gap: 0.5rem;
    min-width: 0;
    max-width: 100%;
    align-self: center;
  }
  .choices {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem 1rem;
    justify-content: center;
  }
  .choice {
    display: flex;
    gap: 0.125rem;
    padding: 0.125rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.5rem;
    background: color-mix(in srgb, var(--sl-color-black) 82%, transparent);
  }
  .choice:empty {
    display: none;
  }
  /* With scripting, one toggle picks which single command box shows. Without
     it there is no toggle, and both boxes show under their headings. */
  .mode {
    justify-self: center;
  }
  .mash-install:not([data-mode]) .mode,
  .mash-install[data-mode] h2,
  .mash-install[data-mode="agent"] .choices,
  .mash-install[data-mode="agent"] .picked,
  .mash-install[data-mode="manual"] .command.agent {
    display: none;
  }
  .choice :global(button) {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    min-width: 0;
    padding: 0.1875rem 0.625rem;
    border: 0;
    border-radius: 0.375rem;
    background: none;
    color: var(--sl-color-gray-2);
    font: 500 var(--sl-text-sm) var(--sl-font);
    cursor: pointer;
  }
  .choice :global(button:hover) {
    color: var(--sl-color-white);
  }
  .choice :global(button[aria-pressed="true"]) {
    background: var(--sl-color-gray-5);
    color: var(--sl-color-white);
  }
  .command {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    min-width: 0;
    padding: 0.375rem 0.375rem 0.375rem 1rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.625rem;
    background: color-mix(in srgb, var(--sl-color-black) 82%, transparent);
    font-family: var(--sl-font-mono);
    font-size: var(--sl-text-sm);
    text-align: start;
  }
  .prompt {
    color: var(--sl-color-gray-3);
    user-select: none;
  }
  code {
    flex: 1;
    min-width: 0;
    overflow-x: auto;
    padding: 0;
    background: none;
    color: var(--sl-color-white);
    white-space: nowrap;
  }
  .command button {
    flex: none;
    min-width: 4.25rem;
    padding: 0.375rem 0.75rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.375rem;
    background: var(--sl-color-gray-6);
    color: var(--sl-color-white);
    font: 500 var(--sl-text-sm) var(--sl-font);
    cursor: pointer;
  }
  .command button:hover {
    border-color: var(--sl-color-gray-3);
  }
  .mash-install p {
    margin: 0;
    color: var(--sl-color-gray-3);
    font-size: var(--sl-text-sm);
  }
  .mash-install h2 {
    margin: 0;
    color: var(--sl-color-gray-2);
    font-size: var(--sl-text-sm);
    font-weight: 600;
    line-height: 1.4;
  }
  .mash-install h2:not(:first-child) {
    margin-top: 0.75rem;
  }
  /* The prompt is a sentence, so it wraps instead of scrolling. */
  code.wrap {
    white-space: normal;
  }
  .mash-install a {
    color: var(--sl-color-text-accent);
  }

  @media (min-width: 50rem) {
    .hero {
      padding-block: clamp(2.5rem, calc(1rem + 10vmin), 10rem);
    }
  }
</style>
