---
// Starlight's hero, over the rippling surface.
import Default from "@astrojs/starlight/components/Hero.astro";
import Surface from "./Surface.astro";
---

<div class="mash-hero">
  <Surface />
  <Default />
</div>

<style>
  .mash-hero {
    position: relative;
    isolation: isolate;
  }
</style>
