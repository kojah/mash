---
// One button in place of Starlight's three-way menu: light or dark, as the
// dashboard offers. The choice is kept under the key Starlight itself reads
// when a page loads, so it holds across pages and visits.
---

<button class="mash-theme" type="button" aria-label="Switch between light and dark mode" title="Switch between light and dark mode">
  <svg class="sun" aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4"></circle><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path></svg>
  <svg class="moon" aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20.5 14.5A8.5 8.5 0 1 1 9.5 3.5a7 7 0 0 0 11 11z"></path></svg>
</button>

<script>
  // One listener for the whole document: the header is replaced when the
  // reader moves between pages without a full load.
  const root = document.documentElement;
  const kept = (): string | null => {
    try {
      return localStorage.getItem("starlight-theme");
    } catch {
      return null;
    }
  };
  document.addEventListener("click", (event) => {
    if (!(event.target instanceof Element) || !event.target.closest(".mash-theme")) return;
    const next = root.dataset.theme === "light" ? "dark" : "light";
    root.dataset.theme = next;
    try {
      localStorage.setItem("starlight-theme", next);
    } catch {
      // The choice still holds for this page.
    }
  });
  // A page swapped in arrives without the choice applied; restore it.
  document.addEventListener("astro:after-swap", () => {
    const choice = kept();
    if (choice === "light" || choice === "dark") root.dataset.theme = choice;
  });
</script>

<style>
  .mash-theme {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.5rem;
    height: 2.5rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.5rem;
    background: transparent;
    color: var(--sl-color-gray-2);
    cursor: pointer;
  }
  .mash-theme:hover {
    border-color: var(--sl-color-gray-4);
    color: var(--sl-color-accent-high);
  }
  /* The icon shows what the button switches to. */
  .moon,
  :global([data-theme="light"]) .sun {
    display: none;
  }
  :global([data-theme="light"]) .moon {
    display: block;
  }
</style>
